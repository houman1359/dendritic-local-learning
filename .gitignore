# LaTeX intermediates
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Reproducible raster previews; publication assets are vector PDFs.
journal/figures/components/*.png
journal/figures/generated/*.png
journal/figures/main/*.png
journal/figures/supplementary/*.png

# Rebuilt submission archives and checksums.
journal/submission/*.zip
journal/submission/*.zip.sha256

# The active branch is also synchronized to Overleaf.  Keep analysis-ready
# result tables and generated reading copies local: canonical TeX sources and
# publication figure PDFs are tracked, while the complete frozen evidence
# snapshot remains recoverable from archive/pre-overleaf-prune-20260820.
journal/source_data/*
!journal/source_data/README.md
!journal/source_data/provenance_manifest.tsv
journal/main.pdf
journal/main_with_supplementary.pdf
journal/supplementary/supplementary.pdf
/main.pdf
neurips/figures/data/
neurips/figures/*.png
neurips/local_credit_assignment.pdf
neurips/local_credit_assignment_arxiv.pdf

# Generated presentation outputs and superseded decks stay local.  The active
# TeX sources and the vector PDF assets they embed remain tracked.
presentations/credit_tree_lib_test.pdf
presentations/dendritic_credit_workshop.pdf
presentations/legacy_decks/

# Talks are maintained in drafts/presentation/credit_assignment, outside this
# manuscript repository. Ignore any local duplicate used while testing assets.
/presentation/

# Public connectomics downloads are cached locally; immutable checksums,
# selected cohorts, and analysis-ready derivatives live under source_data/.
journal/data/

# Experiment configurations are local execution inputs and are not needed to
# compile the Overleaf manuscript. A tracked snapshot remains on
# archive/pre-overleaf-prune-20260820.
journal/configs/**/*.yaml
journal/configs/**/*.yml
neurips/configs/**/*.yaml
neurips/configs/**/*.yml
