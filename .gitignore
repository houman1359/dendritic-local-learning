# This branch is the Overleaf manuscript, not the research-data distribution.
# Overleaf limits editable text to 7 MB per project and 2 MB per file.
# Keep only compilation inputs; research files remain untouched locally and
# are preserved in archive/research-before-overleaf-cleanup-20260918.
# Ignore rules alone do not untrack files: use git rm --cached when needed.

/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/OVERLEAF_README.txt
!/main.tex
!/supplementary.tex
!/journal/
!/neurips/

# Active journal manuscript and complete Supplementary Information.
/journal/*
!/journal/main.tex
!/journal/references.bib
!/journal/naturemag.bst
!/journal/supplementary/
!/journal/figures/
/journal/supplementary/*
!/journal/supplementary/supplementary.tex
!/journal/supplementary/curated/
/journal/supplementary/curated/*
!/journal/supplementary/curated/*.tex

# Final vector sheets only, not previews, provenance tables, intermediate
# components, old layouts, or figure-generation scripts.
/journal/figures/*
!/journal/figures/main/
!/journal/figures/supplementary/
/journal/figures/main/*
!/journal/figures/main/figure_0[1-9].pdf
!/journal/figures/main/figure_10.pdf
/journal/figures/supplementary/*
!/journal/figures/supplementary/curated/
/journal/figures/supplementary/curated/*
!/journal/figures/supplementary/curated/*.pdf

# Keep the NeurIPS manuscript for comparison, without execution scripts,
# configurations, result tables, or generated previews.
/neurips/*
!/neurips/*.tex
!/neurips/*.sty
!/neurips/figures/
/neurips/figures/*
!/neurips/figures/*.pdf
